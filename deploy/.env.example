# Copy to VM as .env next to docker-compose.yml
GROQ_API_KEY=
GEMINI_API_KEY=
# Inside container (must stay 8080 — matches healthcheck + compose mapping)
PORT=8080
# Public / host port (outside container)
HOST_PORT=8084
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional: pin image namespace if compose uses ${DOCKERHUB_USERNAME}
DOCKERHUB_USERNAME=muneeb123
